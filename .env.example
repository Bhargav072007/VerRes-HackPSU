# Public example only: replace POSTGRES_PASSWORD before deploying (use openssl rand -hex 32).
API_DOMAIN=184-197-196-202.sslip.io
POSTGRES_PASSWORD=8d9104e384816ff02303d91082b64d6a486dd8be5bc04922ed7b44165b3c87be
# Blank uses local development defaults. Production Compose supplies this URL:
# DATABASE_URL=postgresql://verres:${POSTGRES_PASSWORD}@db:5432/verres
DATABASE_URL=
GROBID_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI model name; required with OPENAI_API_KEY. Falls back to legacy REVIEW_MODEL.
MODEL_PRIMARY=
# Optional second OpenAI model for whole-source adjudication; shares the LLM daily budget.
MODEL_ADJUDICATOR=
# Same-vendor checks are labeled explicitly. Set false to require cross-vendor adjudication.
ADJUDICATOR_ALLOW_SAME_VENDOR=true
GEMINI_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
FRONTEND_ORIGIN=
DATA_DIR=
LLM_DAILY_BUDGET=
JOBS_PER_HOUR_PER_IP=100
# Comma-separated client IPs exempt from the hourly cap.
RATE_LIMIT_ALLOWLIST=
# Trusted proxy IPs/CIDRs only; blank ignores forwarded headers. Compose pins Caddy.
# Run Uvicorn with --no-proxy-headers so only the app middleware processes them.
FORWARDED_ALLOW_IPS=
ENV=
